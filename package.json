{
	"name": "@kualat/n8n-nodes-kualat",
	"version": "2.0.0",
	"description": "n8n nodes for kua.lat: shorten links, read statistics, and receive signed link events.",
	"keywords": [
		"n8n-community-node-package",
		"n8n",
		"kualat",
		"url-shortener",
		"short-links",
		"links"
	],
	"license": "MIT",
	"homepage": "https://kua.lat",
	"repository": {
		"type": "git",
		"url": "git+https://github.com/kualatLinks/n8n-nodes-kualat.git"
	},
	"bugs": {
		"url": "https://github.com/kualatLinks/n8n-nodes-kualat/issues"
	},
	"engines": {
		"node": ">=18"
	},
	"publishConfig": {
		"access": "public"
	},
	"scripts": {
		"build": "tsc && node scripts/copy-icons.js",
		"dev": "tsc --watch",
		"lint": "tsc --noEmit",
		"prepublishOnly": "npm run lint && npm run build"
	},
	"files": [
		"dist"
	],
	"n8n": {
		"n8nNodesApiVersion": 1,
		"credentials": [
			"dist/credentials/KualatApi.credentials.js"
		],
		"nodes": [
			"dist/nodes/Kualat/Kualat.node.js",
			"dist/nodes/Kualat/KualatTrigger.node.js"
		]
	},
	"peerDependencies": {
		"n8n-workflow": "*"
	},
	"devDependencies": {
		"@types/node": "^20.14.0",
		"n8n-workflow": "^2.16.0",
		"typescript": "^5.5.4"
	}
}
